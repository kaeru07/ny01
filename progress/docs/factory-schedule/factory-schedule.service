[Unit]
Description=Factory scheduled run (Progress AI factory / 定時実行)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=2h
User=root
WorkingDirectory=/root/company/apps/ny01/progress
# 安全判定・二重起動防止・ExecutionRun 記録は progress 側 API に集約。ここは入口を叩くだけ。
ExecStart=/root/company/apps/ny01/progress/docs/factory-schedule/factory-schedule-trigger.sh schedule systemd
