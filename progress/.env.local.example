# Progress data directory
# 未設定時は data/sample/ を読む
# 実データを読む場合は絶対パスまたは相対パスで指定する
# PROGRESS_DATA_PATH=/path/to/real/progress

# 例: company の progress ディレクトリを直接読む場合
# PROGRESS_DATA_PATH=/root/company/progress

# 例: 別プロジェクトの progress ディレクトリを読む場合
# PROGRESS_DATA_PATH=/root/company/apps/ny01/my-progress

# 自走化ゴール達成通知のSMTP設定
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=Googleアプリパスワードを後から記入
# MAIL_FROM="progress <your-address@gmail.com>"
# MAIL_TO=notify-to@example.com
# AUTONOMY_EMAIL_PROVIDER=noop を明示したときだけ実送信を強制無効化
# AUTONOMY_EMAIL_PROVIDER=noop
